# Copy to .env.local and fill in. Never commit .env.local.

# Vaani (https://docs.vaanivoice.ai), X-API-Key auth
VAANI_API_KEY=
VAANI_AGENT_ID=
# Shared secret in the webhook URL: https://<app>/api/webhooks/vaani?token=<this>
VAANI_WEBHOOK_SECRET=

# Cal.com API v2, Bearer auth. Numeric id of the "Studio consultation" event type.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Gemini (@google/genai), a current Flash model. GEMINI_API_KEY may be a comma-separated list: later keys are fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend. Without a verified domain: send from onboarding@resend.dev, to the account owner only.
RESEND_API_KEY=
EMAIL_FROM=Aangan Leads <onboarding@resend.dev>
FRONT_DESK_EMAIL=
OWNER_EMAIL=

# Supabase (service role, server only). Leave both empty with MOCK_EXTERNAL=1 to use an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App secrets
CRON_SECRET=
# At least 16 characters
LINK_SIGNING_SECRET=
DASHBOARD_PASSWORD=
APP_BASE_URL=http://localhost:3000

# 1 = mock Vaani, Cal.com, Gemini and Resend (tests always do)
MOCK_EXTERNAL=1
